<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />

    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="true" />
    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SMIBSVirtual">
        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">

            <!-- <intent-filter> -->
            <!-- <action android:name="android.intent.action.MAIN" /> -->
            <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
            <!-- </intent-filter> -->
        </activity>
        <activity
            android:name=".presentation.SplashActivity"
            android:exported="true"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.DaVClockArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DaVCalculatorArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DaVAutoArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DaVParashuteArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DaVGiantBowArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DavExcavatorArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.DavWheelArActivity"
            android:exported="true" />
        <activity
            android:name=".presentation.ARcameraActivity"
            android:exported="true"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>
        <activity
            android:name=".presentation.ARealityActivity"
            android:exported="true"
            android:label="@string/actionAR"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />
        <activity
            android:name=".presentation.GamesActivity"
            android:exported="true"
            android:label="@string/actionGames"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>
        <activity
            android:name=".presentation.HowActivity"
            android:exported="true"
            android:label="@string/actionHow"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>
        <activity
            android:name=".presentation.AboutActivity"
            android:exported="true"
            android:label="@string/actionAbout"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>
        <activity
            android:name=".presentation.AboutAppActivity"
            android:exported="true"
            android:label="@string/actionAboutApp"
            android:screenOrientation="userPortrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity"/>

        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />
    </application>

</manifest>